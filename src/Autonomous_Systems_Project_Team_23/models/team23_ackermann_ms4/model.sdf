<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="vehicle">
    <link name="chassis">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.010</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.020</iyy>
          <iyz>0.0</iyz>
          <izz>0.025</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.39 0.13 0.035</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.35 0.75 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
          <specular>0.1 0.1 0.2 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.39 0.13 0.035</size>
          </box>
        </geometry>
      </collision>
      <sensor name="chassis_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/vehicle/chassis_contacts</topic>
        <contact>
          <collision>collision</collision>
